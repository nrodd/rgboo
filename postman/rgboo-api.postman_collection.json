    {
      "name": "Admin",
      "description": "The panic button: pulls one user off the stream without touching anyone else's queue. Needs `admin_key`, which is a DIFFERENT secret from `api_key` -- the Worker adds api_key to every request it proxies, so it identifies the Worker rather than a person.\n\nThese are real. Pressing Clear current user cancels that person's queued colours and redacts their name permanently.",
      "item": [
        {
          "name": "Rejected: the Worker's API key",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/clear-current",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "clear-current"
              ]
            },
            "description": "The regular key must NOT open the admin path. This is the whole reason a second secret exists, so it is worth asserting rather than assuming."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('the Worker key is not an admin key', () => pm.expect(pm.response.json().error).to.eql('Unauthorized'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rejected: no key",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/clear-current",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "clear-current"
              ]
            },
            "description": "No credentials at all.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Clear current user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/clear-current",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "clear-current"
              ]
            },
            "description": "Blanks the overlay, cancels only that user's pending requests, and redacts their name in the log. Everyone else keeps their place in the queue.\n\nIdempotent: press it twice and the second call reports nothing displayed.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Admin-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{admin_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('reports what it did', () => {",
                  "  ['cleared_username','cancelled_count','redacted_count','blocked','bridge_online']",
                  "    .forEach(k => pm.expect(b).to.have.property(k));",
                  "});",
                  "pm.test('warns if the bridge cannot act yet', () => {",
                  "  if (!b.bridge_online) console.log('bridge offline - overlay clears when it reconnects');",
                  "  pm.expect(b.status).to.eql('success');",
                  "});",
                  "console.log('cleared:', b.cleared_username, '| cancelled:', b.cancelled_count);"
                ]
              }
            }
          ]
        },
        {
          "name": "Clear a specific user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/clear-current",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "clear-current"
              ]
            },
            "description": "For a name that has already scrolled past. Targets it directly instead of whoever is currently displayed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"SomeName\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Admin-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{admin_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Clear and block",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/clear-current",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "clear-current"
              ]
            },
            "description": "Also adds the name to the denylist so resubmitting it is rejected. Stored as a hash, never the raw string -- otherwise it would undo the redaction.\n\nA speed bump for the lazy repeat offender, not a real defence: anyone determined appends a digit.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"block\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Admin-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{admin_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "// The real contract: a block happens exactly when there was someone",
                  "// to clear. Running this after another clear legitimately finds an",
                  "// empty overlay, so asserting `blocked === true` outright would be",
                  "// asserting run order rather than behaviour.",
                  "pm.test('blocks precisely when someone was cleared', () => {",
                  "  pm.expect(b.blocked).to.eql(b.cleared_username !== null);",
                  "});",
                  "if (b.cleared_username === null) console.log('nothing displayed - nothing to block');"
                ]
              }
            }
          ]
        },
        {
          "name": "Clear the whole queue",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/admin/queue/clear",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "queue",
                "clear"
              ]
            },
            "description": "Cancels EVERY pending request, not just one person's. Moved under /admin because it cancels other people's colours -- a visitor should not be able to trigger it, and the Worker does not proxy /admin/*.\n\nTo remove one user instead, use Clear current user.",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Admin-Key",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{admin_key}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test('reports how many were cancelled', () => pm.expect(b.cleared_count).to.be.a('number'));",
                  "console.log('cancelled', b.cleared_count, 'pending request(s)');"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
