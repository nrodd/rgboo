# Copy to .env.local. Public build-time configuration; never put secrets here.
# Follow the official channel across broadcasts. A video ID can override this.
VITE_YOUTUBE_VIDEO_ID=channel:UC2GJYmn0WCqW8k1NFp1W7KQ

# Optional local preview target. Leave empty for the local backend.
# Setting this to https://rgboo.com sends scene actions to the LIVE stream.
# RGBOO_PUBLIC_API_URL=https://rgboo.com
