# copy to .env.local and edit values as needed

# Development-only preview clip, served from dev-assets/. Ignored in production.
VITE_DEV_EMBED=true

# Direct video URL, not a YouTube/Twitch embed or an RTMP ingest address.
# Use an HTTPS HLS playback manifest (.m3u8) or a browser-playable video file.
# The media server must allow CORS for rgboo.com and localhost development.
VITE_STREAM_URL=

# auto detects .m3u8 URLs; set hls explicitly for extensionless manifests.
VITE_STREAM_TYPE=auto
