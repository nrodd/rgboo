# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored. Real environment variables take precedence over anything
# here, and Cloud Run has no .env at all, so this file is local-only.
# See docs/local-setup.md.

# Any values you like locally -- they only need to match what your client sends.
# In production these are a random 64-char value and a Secret Manager secret.
API_KEY=local-api-secret
ADMIN_KEY=local-admin-secret

# `scripts/dev.sh` overrides these with its local emulator values, so it can
# never reach the shared production database. They are here for people who run
# an individual process themselves.
GOOGLE_CLOUD_PROJECT=rgboo-local
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081

# Do not set GOOGLE_APPLICATION_CREDENTIALS for the local emulator. It needs
# neither gcloud login nor a service-account key. Production credentials belong
# only in the deployment environment.

# Bridge: OBS overlay server. Change the port if 5001 is taken.
# BRIDGE_OBS_PORT=5001
# BRIDGE_LOG_LEVEL=INFO
