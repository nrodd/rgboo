# Copy to .env for local development:  cp .env.example .env
#
# .env is gitignored. Real environment variables take precedence over anything
# here, and Cloud Run has no .env at all, so this file is local-only.
# See docs/local-setup.md.

# Any values you like locally -- they only need to match what your client sends.
# In production these are a random 64-char value and a Secret Manager secret.
API_KEY=local-api-secret
# Cloudflare Access admin authentication (use your Zero Trust team domain,
# application AUD tag, and comma-separated allowed admin emails).
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUDIENCE=your-access-application-audience
ADMIN_EMAILS=admin@example.com

# The GCP project both processes read and write. There is no local database:
# this is the real, shared Firestore.
GOOGLE_CLOUD_PROJECT=rgboo-leds

# Usually unnecessary -- `gcloud auth application-default login` is the
# recommended path. Only set this if you have been given a service-account key.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json

# Bridge: OBS overlay server. Change the port if 5001 is taken.
# BRIDGE_OBS_PORT=5001
# BRIDGE_LOG_LEVEL=INFO
