CLOUD_API_URL=https://rgboo-api-186324327580.us-east1.run.app
CLOUD_API_KEY=replace-with-the-cloud-api-key

# Leave IDs empty to disable a platform. Enable at least one.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UC2GJYmn0WCqW8k1NFp1W7KQ
# Optional: pin a specific broadcast instead of whatever the channel is live
# with. Takes precedence over YOUTUBE_CHANNEL_ID.
YOUTUBE_VIDEO_ID=
# Optional: skip both lookups above and go straight to a known chat ID; takes
# precedence over both.
YOUTUBE_LIVE_CHAT_ID=
# OAuth for posting estimates (youtube.force-ssl scope).
YOUTUBE_ACCESS_TOKEN=
# Recommended automatic refresh; all three required. Access token may be empty.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Persistent Pacific-day counters; keep /data mounted across container recreations.
YOUTUBE_BUDGET_FILE=/data/youtube-budget.sqlite3
# At most 160 reply attempts (8,000 quota units) and 1,000 read/connection attempts/day.
# Lower these if other apps use the same Google project. Set replies to 0 to disable.
YOUTUBE_DAILY_REPLIES=160
YOUTUBE_DAILY_READS=1000

TWITCH_CLIENT_ID=
TWITCH_BOT_USER_ID=
TWITCH_BROADCASTER_ID=
# User token needs both user:read:chat and user:write:chat.
TWITCH_ACCESS_TOKEN=
# Optional automatic OAuth refresh (all three required).
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=
TWITCH_TOKEN_FILE=/data/twitch-tokens.json
